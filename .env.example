# Build-time values: Vite writes them into the bundle. See "Configuration" in README.md.

# Browser tab title
VITE_APP_TITLE=

# Not in use. Base URLs of the backend and WFS clients of @geoint/geoint-vue,
# which the app does not call.
VITE_API_URL=
VITE_GEOSERVER_URL=

# Keycloak. Realm and client must match docker/keycloak/citiobs-realm.json.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=citiobs
VITE_KEYCLOAK_CLIENT_ID=co-frontend
